# Copy this file to backend/.env and fill in the real values.
# NEVER commit the real .env file. It is listed in .gitignore.

# Supabase: Project Settings > Database > Connection string (URI). Replace the password.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres

# At least 32 random characters. Create one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string

ACCESS_TOKEN_EXPIRE_MINUTES=60

# Addresses of the web client allowed to call the API (comma separated)
ALLOWED_ORIGINS=http://localhost:3000
